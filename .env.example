# Google Cloud / Vertex AI Application Default Credentials (Recommended for Argolis & Cloud Run)
GOOGLE_GENAI_USE_VERTEXAI="true"
GOOGLE_CLOUD_PROJECT="clayberg-scouts-bsa-prod"
GOOGLE_CLOUD_LOCATION="us-central1"

# Optional Gemini API Key (Leave blank when using Vertex AI ADC in Argolis)
GEMINI_API_KEY="your-gemini-api-key-here"
GOOGLE_API_KEY="your-google-api-key-here"

# Observability Configuration
LOG_LEVEL="INFO"
ENABLE_OPENTELEMETRY="true"
ENABLE_PII_REDACTION_BEFORE_SINK="true"

# Local Storage Database Path
LOCAL_SQLITE_DB_PATH="scouts_bsa_sessions.db"
