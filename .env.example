# Google Gemini / Vertex AI API Key
GEMINI_API_KEY="your-gemini-api-key-here"
GOOGLE_API_KEY="your-google-api-key-here"

# Google Cloud Project & Location (Optional for local execution, required for Cloud Run / Vertex AI Search)
GOOGLE_CLOUD_PROJECT="clayberg-scouts-bsa-prod"
GOOGLE_CLOUD_LOCATION="us-central1"

# Observability Configuration
LOG_LEVEL="INFO"
ENABLE_OPENTELEMETRY="true"
ENABLE_PII_REDACTION_BEFORE_SINK="true"

# Local Storage Database Path
LOCAL_SQLITE_DB_PATH="scouts_bsa_sessions.db"
